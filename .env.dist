# Copier en .env : cp .env.dist .env
DEVBOX_HOSTNAME=dev.localhost
# Ports publiés par traefik (80/443 occupés par apache2 sur l'hôte)
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
# Ports publiés uniquement sur la boucle locale
DEVBOX_PORT_PREFIX=127.0.0.1:
# Ports publiés sur l'hôte (5432 occupé par le postgresql de l'hôte)
POSTGIS_PORT=5433
REDIS_PORT=6379
OPENSEARCH_PORT=9200

# Préfixe du miroir DockerHub (avec "/" final), vide = DockerHub direct
# Ex IGN : 690uto8c.gra7.container-registry.ovh.net/gpf-dockerhub/
DOCKERHUB_PROXY=

# Images (versions fixées ; préfixées par DOCKERHUB_PROXY sauf Keycloak, hébergé sur quay.io)
TRAEFIK_IMAGE=traefik:v3.6.25
PORTAINER_IMAGE=portainer/portainer-ce:2.45.3
PGADMIN_IMAGE=dpage/pgadmin4:9.19
REDIS_IMAGE=library/redis:7.4.12-alpine
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.2.0
OPENSEARCH_DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:3.2.0
REDMINE_IMAGE=library/redmine:6.1.6
MATOMO_IMAGE=library/matomo:5.14.2
MATOMO_DB_IMAGE=library/mariadb:10.11.19
GEOSERVER_IMAGE=kartoza/geoserver:2.28.5
# Keycloak : image complète, non préfixée par DOCKERHUB_PROXY (adapter si miroir quay.io)
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.7

# PostgreSQL / PostGIS (même version que gpu-site : 15-3.3)
POSTGIS_IMAGE=postgis/postgis:15-3.3
POSTGRES_USER=postgis
POSTGRES_PASSWORD=ChangeIt
# Bases créées par postgis/create-databases.sh
GPU_SITE_DB=gpu-site
REDMINE_DB=redmine
KEYCLOAK_DB=keycloak

# Redis
REDIS_PASSWORD=ChangeIt

# Matomo (MariaDB dédiée)
MATOMO_DB_PASSWORD=ChangeIt
MATOMO_DB_ROOT_PASSWORD=ChangeIt

# Redmine
REDMINE_SECRET_KEY_BASE=ChangeItChangeItChangeItChangeIt

# Keycloak (base "keycloak" sur le conteneur postgis)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeIt

# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=ChangeIt

# Portainer : mot de passe admin initial (12 caractères minimum), appliqué au premier démarrage
PORTAINER_ADMIN_PASSWORD=ChangeIt12345

# pgAdmin (mode desktop, sans login ; serveur postgis préconfiguré)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=ChangeIt
